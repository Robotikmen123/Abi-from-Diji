# --- ZEKA (LLM) ---------------------------------------------------------
# ABI'nin zekasi Google Gemini uzerinden calisir.
# Anahtar: https://aistudio.google.com/apikey  (ucretsiz kotasi var)
GEMINI_API_KEY=

# Model tercihi. Bulunamazsa otomatik olarak bilinen surumlere duser.
GEMINI_MODEL=gemini-2.5-flash

# gemini | ollama | openai | local | auto
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=220

# --- SES ----------------------------------------------------------------
# Ses de Gemini'den gelir; ayni anahtar kullanilir, ek kurulum yok.
# auto | gemini | piper | client
TTS_PROVIDER=auto

# Kalin, tok erkek sesler: Charon (varsayilan) · Algenib · Gacrux · Alnilam · Orus
ABI_VOICE=Charon
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Cevrimdisi yedek: Piper (npm run voices ile iner, zorunlu degil)
# PIPER_VOICE=tr_TR-fahrettin-medium
# PIPER_VOICES_DIR=models/piper
# PIPER_LENGTH_SCALE=1.0

# --- YEREL TANIMA (Whisper) --------------------------------------------
# auto | whisper | client
STT_PROVIDER=auto
# tiny | base | small | medium  (buyudukce dogru ama yavas)
WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# --- ISTEGE BAGLI YEDEKLER ---------------------------------------------
# Anahtarsiz local alternatif (kuruluysa otomatik bulunur)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# OpenAI uyumlu endpoint
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- KARAKTER -----------------------------------------------------------
ABI_NAME=ABİ
PORT=8787
